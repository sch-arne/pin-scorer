<?xml version="1.0" encoding="utf-8"?>
<!-- Funktioniert in beiden Lagen. Das Querformat zeigt mehr Bahnen
     nebeneinander, aber die Lage gibt das Stativ vor, nicht die App: Viele
     Stative halten nur hochkant.

     Die Raender kommen NICHT aus dieser Datei, sondern zur Laufzeit aus den
     Fenstereinzuegen: Seit Android 15 zeichnen Anwendungen randlos, und
     Statusleiste, Navigation und Kameraausschnitt liegen sonst ueber dem
     Inhalt. Feste Abstaende waeren auf jedem zweiten Geraet falsch. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/wurzel"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- fitCenter statt Zuschnitt: Der Nutzer soll beim Ausrichten genau das
         sehen, was auch die Erkennung sieht. -->
    <androidx.camera.view.PreviewView
        android:id="@+id/vorschau"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:scaleType="fitCenter" />

    <ScrollView
        android:id="@+id/ausgabe_rahmen"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="#D0000000"
        android:maxHeight="220dp">

        <TextView
            android:id="@+id/ausgabe"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:padding="12dp"
            android:textColor="#FFFFFF"
            android:textIsSelectable="true"
            android:textSize="14sp"
            android:text="startet ..." />
    </ScrollView>

    <LinearLayout
        android:id="@+id/knopfleiste"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:orientation="horizontal"
        android:padding="12dp">

        <Button
            android:id="@+id/knopf_selbsttest"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="Selbsttest" />

        <Button
            android:id="@+id/knopf_tafeln"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Suche laeuft" />
    </LinearLayout>
</FrameLayout>
