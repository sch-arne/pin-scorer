# Zugangsdaten und die Adresse der Datenbank.
#
# Diese Datei ist die VORLAGE. Kopieren nach `.env` und ausfuellen -- `.env`
# selbst ist von der Versionsverwaltung ausgeschlossen und bleibt hier.
#
# Ohne diese Werte laeuft das Werkzeug vollstaendig: Video oder Stream laden,
# kalibrieren, analysieren, Wurftabellen, Wurfprotokoll als CSV. Nur der
# Versand an die Datenbank unterbleibt -- er meldet das einmal im Protokoll
# und die Analyse laeuft weiter (P8).

# Projekt-URL: Supabase-Dashboard -> Settings -> API -> Project URL.
# Kein Geheimnis, aber sie benennt die Datenbank EINES BESTIMMTEN Vereins --
# deshalb steht sie hier und nicht in `config/default.yaml`.
SUPABASE_URL=https://abcdefgh.supabase.co

# SCHREIBENDER Schluessel, fuer die Bilderkennung. Sie laeuft lokal und ist
# kein Browser -- hier ist der geheime Schluessel richtig aufgehoben.
# Supabase-Dashboard -> Settings -> API keys -> secret (`sb_secret_...`).
SUPABASE_KEY=

# LESENDER Schluessel, fuer den Liveticker. Er landet in der ausgelieferten
# HTML-Datei und ist damit fuer jeden lesbar, der sie oeffnet -- genau dafuer
# ist ein `sb_publishable_...` gedacht.
#
# `start.py` und `build.py` BRECHEN AB, wenn hier etwas steht, das nach
# `sb_secret_` oder `service_role` aussieht. GEMESSEN 2026-09-11 gegen die
# Tabelle `throws`: Lesen HTTP 200, Schreiben HTTP 401 `42501`.
SUPABASE_READ_KEY=

# ---------------------------------------------------------------------------
# PIN SCORER -- ergaenzt in dieser Kopie (siehe HERKUNFT.md)
# ---------------------------------------------------------------------------
# Die erkannten Wuerfe gehen in die Datenbank des Pin Scorers, Tabelle
# `erkannter_wurf`. Eingerichtet wird das in docs/PINS_SCORER.md; hier stehen
# nur die Werte.
#
# Eigene Namen statt der SUPABASE_*-Werte oben, mit Absicht: Dort ist der
# Schreibschluessel der GEHEIME Schluessel. Der umgeht jede Zeilen-Sicherheit
# und hat auf einem Rechner, der offen an der Bahn steht, nichts zu suchen --
# hier wird er aktiv abgewiesen.

# Schalter. Steht hier nichts oder etwas anderes als 1/true/ja, geht nichts an
# den Pin Scorer (und der Upstream-Weg oben greift wie gehabt).
PINS_SCORER=

# Projekt-URL des Pin Scorers (Supabase -> Settings -> API -> Project URL).
PINS_SCORER_URL=

# Der OEFFENTLICHE Schluessel: sb_publishable_... bzw. der alte anon-Key. Er
# allein darf nichts; geschrieben wird erst mit der Anmeldung darunter.
PINS_SCORER_KEY=

# Die id aus der Tabelle `erkenner` -- WELCHES Geraet hier liefert. Darueber
# findet die App Anlage und Bahn. Anlegen: docs/PINS_SCORER.md, Schritt 3.
PINS_SCORER_ERKENNER=

# Der Zugang dieses Erkenners (ein Supabase-Benutzer fuer das GERAET, nicht der
# eines Menschen). Er darf ausschliesslich Wuerfe fuer die erkenner_id oben
# einfuegen -- nicht lesen, nicht aendern, nicht loeschen.
PINS_SCORER_EMAIL=
PINS_SCORER_PASSWORT=

# Tabelle -- nur setzen, wenn sie anders heisst als `erkannter_wurf`.
PINS_SCORER_TABELLE=
